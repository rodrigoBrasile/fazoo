---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base titulo="Página não encontrada">
  <section class="section erro">
    <div class="container">
      <div class="rosto" aria-hidden="true">
        <span></span><span></span><i></i>
      </div>
      <h1>Ops! Essa página não existe.</h1>
      <p class="lede">O endereço pode ter mudado ou o produto saiu da vitrine.</p>
      <a class="btn btn-white" href="/">Voltar para o início <Icon nome="seta" /></a>
    </div>
  </section>
</Base>

<style>
  .erro .container {
    display: grid;
    justify-items: center;
    gap: 20px;
    text-align: center;
    padding-block: 40px;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
  }

  .rosto {
    position: relative;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--pink), var(--violet));
    border: 6px solid #fff;
    box-shadow: 0 20px 50px -16px rgba(242, 39, 240, 0.9);
  }

  .rosto span {
    position: absolute;
    top: 30%;
    width: 24%;
    height: 24%;
    border-radius: 50%;
    border: 9px solid #fff;
  }

  .rosto span:first-child {
    left: 20%;
  }

  .rosto span:nth-child(2) {
    right: 20%;
  }

  .rosto i {
    position: absolute;
    left: 32%;
    right: 32%;
    top: 66%;
    height: 14%;
    border: 9px solid #fff;
    border-bottom: 0;
    border-radius: 999px 999px 0 0;
  }
</style>
