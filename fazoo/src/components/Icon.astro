---
// Ícones simples desenhados em SVG, sem dependências.
interface Props {
  nome:
    | 'whatsapp'
    | 'instagram'
    | 'loja'
    | 'seta'
    | 'menu'
    | 'fechar'
    | 'voltar'
    | 'lampada'
    | 'qualidade'
    | 'caixa'
    | 'coracao';
  class?: string;
}
const { nome, class: classe } = Astro.props;
---

<svg
  class={classe}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {nome === 'whatsapp' && (
    <>
      <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z" />
      <path d="M9 8.6c.2-.5.6-.6 1-.6l.6 1.5-.6.9c.4.9 1.2 1.8 2.3 2.4l.9-.7 1.5.7c0 .5-.2.9-.7 1.1-1.6.6-5.6-2.6-5-5.3z" fill="currentColor" stroke-width="1" />
    </>
  )}
  {nome === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5.5" />
      <circle cx="12" cy="12" r="4.2" />
      <circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none" />
    </>
  )}
  {nome === 'loja' && (
    <>
      <path d="M4 9.5V20h16V9.5" />
      <path d="M3 9.5L5 4h14l2 5.5a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0z" />
      <path d="M10 20v-5h4v5" />
    </>
  )}
  {nome === 'seta' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {nome === 'voltar' && <path d="M19 12H5M11 6l-6 6 6 6" />}
  {nome === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {nome === 'fechar' && <path d="M6 6l12 12M18 6L6 18" />}
  {nome === 'lampada' && (
    <>
      <path d="M9 18h6M10 21h4" />
      <path d="M12 6a5 5 0 0 0-3 9c.6.5 1 1.2 1 2h4c0-.8.4-1.5 1-2a5 5 0 0 0-3-9z" />
      <path d="M12 2v1M4.5 5.5l.8.8M19.5 5.5l-.8.8M2 12h1M21 12h1" />
    </>
  )}
  {nome === 'qualidade' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M8.3 12.2l2.5 2.5 4.9-5" />
    </>
  )}
  {nome === 'caixa' && (
    <>
      <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z" />
      <path d="M4 7.5l8 4.5 8-4.5M12 12v9" />
    </>
  )}
  {nome === 'coracao' && (
    <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z" />
  )}
</svg>
