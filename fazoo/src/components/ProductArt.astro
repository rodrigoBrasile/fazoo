---
// Arte provisória desenhada em SVG, usada enquanto o produto não tem foto.
import type { Categoria } from '../config';

interface Props {
  categoria: Categoria;
  id: string;
  variante?: number;
  rotulo?: string;
}

const { categoria, id, variante = 0, rotulo = 'SEU NOME' } = Astro.props;

const paletas = [
  ['#1aa3ff', '#2457ff'],
  ['#f227f0', '#7b2bff'],
  ['#2457ff', '#7b2bff'],
  ['#7b2bff', '#f227f0'],
  ['#1aa3ff', '#7b2bff'],
];
const [c1, c2] = paletas[variante % paletas.length];
const g = `art-${id}`;
const camadas = Array.from({ length: 9 }, (_, k) => (k + 1) * 9.5);
---

<svg class="arte" viewBox="0 0 400 300" role="img" aria-label="Ilustração provisória do produto">
  <defs>
    <linearGradient id={`${g}-a`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={c1} />
      <stop offset="1" stop-color={c2} />
    </linearGradient>
    <linearGradient id={`${g}-b`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={c2} />
      <stop offset="1" stop-color="#0c1154" />
    </linearGradient>
    <radialGradient id={`${g}-glow`} cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color={c1} stop-opacity="0.55" />
      <stop offset="1" stop-color={c1} stop-opacity="0" />
    </radialGradient>
  </defs>

  <ellipse cx="200" cy="160" rx="170" ry="120" fill={`url(#${g}-glow)`} />

  {categoria === 'impressao-3d' && (
    <g>
      <ellipse cx="200" cy="262" rx="96" ry="14" fill="#04062a" opacity="0.55" />
      <polygon points="200,82 280,126 200,170 120,126" fill={`url(#${g}-a)`} />
      <polygon points="120,126 200,170 200,258 120,214" fill={`url(#${g}-b)`} />
      <polygon points="200,170 280,126 280,214 200,258" fill={c2} opacity="0.85" />
      <g stroke="#ffffff" stroke-opacity="0.16" stroke-width="1.5">
        {camadas.map((o) => (
          <>
            <line x1="120" y1={126 + o} x2="200" y2={170 + o} />
            <line x1="200" y1={170 + o} x2="280" y2={126 + o} />
          </>
        ))}
      </g>
      <polyline points="120,126 200,82 280,126" fill="none" stroke="#fff" stroke-opacity="0.55" stroke-width="2" />
      <rect x="176" y="22" width="48" height="26" rx="8" fill="#e8eaff" />
      <polygon points="190,48 210,48 203,62 197,62" fill="#c9cdf5" />
      <circle cx="200" cy="66" r="5" fill="#fff" />
      <circle cx="200" cy="66" r="12" fill="#fff" opacity="0.25" />
    </g>
  )}

  {categoria === 'bottons' && (
    <g>
      <ellipse cx="208" cy="262" rx="88" ry="13" fill="#04062a" opacity="0.55" />
      <circle cx="200" cy="148" r="100" fill="#fff" />
      <circle cx="200" cy="148" r="92" fill={`url(#${g}-a)`} />
      <g fill="none" stroke="#fff" stroke-width="14" stroke-linecap="round">
        <circle cx="166" cy="128" r="20" />
        <circle cx="234" cy="128" r="20" />
        <path d="M168 176 Q200 206 232 176" />
      </g>
      <path d="M128 96 A 88 88 0 0 1 196 62" fill="none" stroke="#fff" stroke-opacity="0.55" stroke-width="10" stroke-linecap="round" />
    </g>
  )}

  {categoria === 'personalizados' && (
    <g>
      <ellipse cx="210" cy="262" rx="110" ry="13" fill="#04062a" opacity="0.55" />
      <circle cx="104" cy="104" r="26" fill="none" stroke="#e8eaff" stroke-width="7" />
      <g transform="rotate(-10 210 160)">
        <rect x="104" y="108" width="236" height="104" rx="30" fill={`url(#${g}-a)`} />
        <rect x="104" y="108" width="236" height="104" rx="30" fill="none" stroke="#fff" stroke-opacity="0.35" stroke-width="2" />
        <circle cx="140" cy="160" r="12" fill="#0c1154" />
        <text
          x="242"
          y="171"
          text-anchor="middle"
          fill="#fff"
          font-family="Fredoka, ui-rounded, sans-serif"
          font-weight="700"
          font-size="30"
          letter-spacing="1">{rotulo}</text>
      </g>
      <path d="M318 62 l6 14 14 6 -14 6 -6 14 -6 -14 -14 -6 14 -6z" fill="#fff" />
      <path d="M86 214 l4 9 9 4 -9 4 -4 9 -4 -9 -9 -4 9 -4z" fill="#fff" opacity="0.7" />
    </g>
  )}
  {categoria === 'natal' && (
    <g>
      <ellipse cx="200" cy="264" rx="92" ry="13" fill="#04062a" opacity="0.55" />
      <rect x="186" y="226" width="28" height="34" rx="6" fill="#c9cdf5" />
      <polygon points="200,92 286,232 114,232" fill={`url(#${g}-a)`} />
      <polygon points="200,72 262,170 138,170" fill={`url(#${g}-a)`} />
      <polygon points="200,56 240,118 160,118" fill={`url(#${g}-a)`} />
      <g stroke="#ffffff" stroke-opacity="0.18" stroke-width="1.5">
        {camadas.map((o) => <line x1={150 - o * 0.4} y1={140 + o} x2={250 + o * 0.4} y2={140 + o} />)}
      </g>
      <circle cx="176" cy="200" r="7" fill="#fff" />
      <circle cx="226" cy="150" r="6" fill="#fff" opacity="0.85" />
      <circle cx="236" cy="210" r="6" fill="#fff" opacity="0.7" />
      <path d="M200 26 l7 15 16 3 -12 11 3 16 -14 -8 -14 8 3 -16 -12 -11 16 -3z" fill="#fff" />
    </g>
  )}
</svg>

<style>
  .arte {
    width: 100%;
    height: 100%;
  }
</style>
