---
import Icon from './Icon.astro';
import { linkWhatsApp } from '../config';

const destaques = [
  { icone: 'lampada', titulo: 'Personalizados', texto: 'Do seu jeito, como você imagina' },
  { icone: 'qualidade', titulo: 'Qualidade', texto: 'Acabamento que surpreende' },
  { icone: 'caixa', titulo: 'Diversos produtos', texto: 'Presentes, decoração, organização e muito mais' },
  { icone: 'coracao', titulo: 'Feito com carinho', texto: 'Porque cada detalhe importa' },
] as const;
---

<section class="hero">
  <div class="container grade">
    <div class="texto">
      <span class="chip"><span class="ponto"></span> Impressão 3D + Bottons · Feito do seu jeito</span>
      <h1>
        Ideias que ganham forma,
        <span class="grad-text">camada por camada.</span>
      </h1>
      <p class="lede">
        A Fazoo cria peças em impressão 3D e bottons personalizados para decorar, organizar, presentear e mostrar
        o seu estilo.
      </p>
      <div class="acoes">
        <a class="btn btn-white" href="#produtos">Ver produtos <Icon nome="seta" /></a>
        <a class="btn" href={linkWhatsApp('Olá! Quero fazer um pedido personalizado na Fazoo.')} target="_blank" rel="noopener">
          <Icon nome="whatsapp" /> Pedir personalizado
        </a>
      </div>
      <ul class="selos">
        <li>Peças sob encomenda</li>
        <li>Personalizados com a sua arte</li>
        <li>Também nos marketplaces</li>
      </ul>
    </div>

    <div class="painel">
      <p class="balao">Ideias viram realidade!</p>

      <div class="nota" aria-hidden="true">
        <span>Suas ideias ganham forma!</span>
        <svg class="seta-nota" viewBox="0 0 80 60" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M66 4 C 70 30, 50 48, 12 50" />
          <path d="M22 40 L 10 50 L 23 58" />
        </svg>
      </div>

      <div class="marca">
        <svg class="riscos" viewBox="0 0 60 60" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" aria-hidden="true">
          <path d="M14 30 L 6 8" />
          <path d="M28 28 L 40 10" />
          <path d="M34 42 L 54 34" />
        </svg>
        <img src="/logo-fazoo-web.png" alt="Fazoo" width="640" height="260" fetchpriority="high" />
        <p class="assinatura">Feito do seu jeito</p>
      </div>

      <ul class="destaques">
        {destaques.map((d) => (
          <li>
            <span class="icone"><Icon nome={d.icone} /></span>
            <strong>{d.titulo}</strong>
            <span class="desc">{d.texto}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(32px, 6vw, 72px) clamp(56px, 8vw, 96px);
    overflow: hidden;
  }

  .grade {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
  }

  .texto {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .ponto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 12px var(--pink);
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    font-weight: 700;
    line-height: 1.02;
  }

  h1 .grad-text {
    display: inline-block;
    padding-bottom: 0.08em;
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .selos {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .selos li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .selos li::before {
    content: '';
    width: 16px;
    height: 8px;
    border: 2.5px solid var(--cyan);
    border-top: 0;
    border-radius: 0 0 16px 16px;
  }

  /* Painel da marca, inspirado no banner da Fazoo */
  .painel {
    position: relative;
    display: grid;
    gap: clamp(22px, 3vw, 30px);
    padding: clamp(92px, 11vw, 112px) clamp(8px, 2vw, 16px) 0;
    min-width: 0;
    isolation: isolate;
  }

  /* Brilho suave atrás do logo, sem caixa. */
  .painel::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 46%;
    width: 110%;
    aspect-ratio: 1.4;
    transform: translate(-50%, -50%);
    background:
      radial-gradient(closest-side at 62% 40%, rgba(242, 39, 240, 0.32), transparent 70%),
      radial-gradient(closest-side at 38% 55%, rgba(36, 87, 255, 0.38), transparent 75%);
    filter: blur(20px);
    pointer-events: none;
  }

  .balao {
    position: absolute;
    top: clamp(18px, 3vw, 26px);
    left: clamp(14px, 3vw, 26px);
    max-width: 9.5em;
    padding: 10px 16px;
    border-radius: 18px;
    background: var(--pink);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    line-height: 1.1;
    text-align: center;
    transform: rotate(-7deg);
    box-shadow: 0 12px 30px -10px rgba(242, 39, 240, 0.95);
    animation: balancar 6s ease-in-out infinite;
  }

  .balao::after {
    content: '';
    position: absolute;
    right: 18px;
    bottom: -12px;
    border-width: 14px 6px 0 14px;
    border-style: solid;
    border-color: var(--pink) transparent transparent transparent;
  }

  .nota {
    position: absolute;
    top: clamp(14px, 2.4vw, 22px);
    right: clamp(14px, 3vw, 28px);
    display: grid;
    justify-items: end;
    color: #ffc8fb;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    line-height: 0.95;
    text-align: right;
    transform: rotate(6deg);
  }

  .nota span {
    max-width: 7em;
  }

  .seta-nota {
    width: 46px;
    height: 34px;
    margin-right: 46px;
    margin-top: 2px;
  }

  .marca {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  .marca img {
    width: min(78%, 420px);
    height: auto;
    filter: drop-shadow(0 10px 30px rgba(10, 8, 60, 0.55));
  }

  .riscos {
    position: absolute;
    top: 6px;
    right: calc(50% - min(39%, 210px) - 30px);
    width: 38px;
    height: 38px;
    color: var(--pink);
  }

  .assinatura {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.85rem, 1.5vw, 1.05rem);
    letter-spacing: 0.38em;
    text-transform: uppercase;
    padding-left: 0.38em;
    color: #fff;
  }

  .destaques {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .destaques li {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 6px;
    text-align: center;
  }

  .icone {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 4px;
    border-radius: 16px;
    background: rgba(6, 6, 40, 0.65);
    border: 1.5px solid rgba(242, 39, 240, 0.65);
    color: #fff;
    box-shadow:
      0 0 18px rgba(242, 39, 240, 0.45),
      inset 0 0 12px rgba(242, 39, 240, 0.25);
  }

  .icone :global(svg) {
    width: 28px;
    height: 28px;
    filter: drop-shadow(0 0 6px rgba(255, 140, 246, 0.9));
  }

  .destaques strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.76rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .desc {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.82rem;
    line-height: 1.3;
  }

  @keyframes balancar {
    0%, 100% { transform: rotate(-7deg) translateY(0); }
    50% { transform: rotate(-4deg) translateY(-5px); }
  }

  @media (max-width: 980px) {
    .grade {
      grid-template-columns: 1fr;
    }

    .painel {
      max-width: 620px;
      width: 100%;
      justify-self: center;
      padding-inline: 0;
    }
  }

  @media (max-width: 520px) {
    .destaques {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 10px;
    }

    .riscos {
      width: 28px;
      height: 28px;
      top: 2px;
      right: calc(50% - min(39%, 210px) - 22px);
    }
  }
</style>
